
@model IEnumerable<_25DH110424_Lê_Trung_Kỳ_MyStore.Models.Order>
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-default">
    <div class="panel-body">

        @using (Html.BeginForm("Index", "Orders", FormMethod.Get))
        {
            <div class="row">

                <div class="col-md-3">
                    <label>Tên khách hàng</label>
                    <input type="text"
                           name="customerName"
                           value="@ViewBag.CustomerName"
                           class="form-control"
                           placeholder="Tên khách hàng..." />
                </div>

                <div class="col-md-3">
                    <label>Trạng thái thanh toán</label>
                    <select name="paymentStatus" class="form-control">
                        <option value="">Tất cả</option>

                        @foreach (var status in ViewBag.PaymentStatuses)
                        {
                            <option value="@status"
                                    @(ViewBag.PaymentStatus == status ? "selected" : "")>
                                @status
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label>Ngày đặt hàng</label>
                    <input type="date"
                           name="orderDate"
                           value="@ViewBag.OrderDate"
                           class="form-control" />
                </div>

                <div class="col-md-3">
                    
                    <button type="submit"
                            class="btn btn-primary form-control">
                        <span class="glyphicon glyphicon-search"></span>
                        Tìm kiếm
                    </button>
                </div>

            </div>
        }

    </div>
</div>

<div class="panel panel-primary">
    <div class="panel-heading"><h3 class="panel-title">Quản lý đơn hàng</h3></div>
    <div class="panel-body">
        <table class="table table-bordered table-striped table-hover">
            <thead>
                <tr style="background-color:#337ab7; color:#fff;">

                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Trạng thái vận chuyển </th>
                    <th>Phương thức vận chuyển</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>

                        <td>@o.Customer.CustomerName</td>
                        <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@o.TotalAmount.ToString("N0") đ</td>
                        <td>@o.PaymentStatus</td>
                        <td>@o.OrderStatus</td>
                        <td>@o.DeliveryMethod</td>
                        <td>@Html.ActionLink("Chi tiết", "OrderDetails", "Customers", new { area = "Admin", id = o.OrderID }, new { @class = "btn btn-info btn-sm" })</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>